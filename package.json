{
  "name": "crx2xpi",
  "version": "0.3.0",
  "description": "Convert Chrome MV3 extensions (CRX3) into Firefox/GeckoView-compatible XPI add-ons.",
  "license": "Apache-2.0",
  "author": "url9 and the crx2xpi contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/url9/crx2xpi.git"
  },
  "bugs": {
    "url": "https://github.com/url9/crx2xpi/issues"
  },
  "homepage": "https://github.com/url9/crx2xpi#readme",
  "type": "module",
  "bin": {
    "crx2xpi": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "node scripts/publish-audit.mjs",
    "prepublishOnly": "pnpm run audit",
    "commit": "cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.12",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.1.1",
    "webextension-polyfill": "^0.12.0"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "commander": "15.1.0"
  }
}
