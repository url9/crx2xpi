{
  "name": "crx2xpi",
  "version": "0.1.0",
  "description": "Convert Chrome MV3 extensions (CRX3) into Firefox/GeckoView-compatible XPI add-ons.",
  "license": "Apache-2.0",
  "author": "ckb66 and the crx2xpi contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckb66/crx2xpi.git"
  },
  "bugs": {
    "url": "https://github.com/ckb66/crx2xpi/issues"
  },
  "homepage": "https://github.com/ckb66/crx2xpi#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "commit": "cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^50.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
